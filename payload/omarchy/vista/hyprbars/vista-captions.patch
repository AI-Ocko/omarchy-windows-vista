+// Where a button's top edge sits in a bar of height barH: hung from the top
+// (bar_button_top >= 0, Vista) or centred (XP, upstream).
+static double buttonTop(const SHyprButton& b, double barH) {
+    const auto TOP = g_pGlobalState->config.barButtonTop->value();
+    return TOP >= 0 ? (double)TOP : std::floor((barH - b.h()) / 2.0);
+}
+
+// ---- XP caption art (bg_image / fg_image / fg_image_alt)
+
+static SP<Render::ITexture> loadPng(const std::string& path, bool nearest = true) {
+    const auto SURFACE = cairo_image_surface_create_from_png(path.c_str());
+
+    if (cairo_surface_status(SURFACE) != CAIRO_STATUS_SUCCESS) {
+        Log::logger->log(Log::ERR, "[hyprbars] failed to load {}", path);
+        cairo_surface_destroy(SURFACE);
+        return nullptr;
+    }
+
+    auto tex = g_pHyprRenderer->createTexture(SURFACE);
+    cairo_surface_destroy(SURFACE);
+
+    // XP pixel art: never blur it. Vista's caption image and glass overlay are
+    // drawn at fractional scales, smoothly.
+    if (tex && nearest)
+        tex->magFilter = tex->minFilter = GL_NEAREST;
+
+    return tex;
+}
+
+static std::vector<SP<Render::ITexture>> loadFrames(const std::string& pattern, int count = 8, bool nearest = true) {
+    std::vector<SP<Render::ITexture>> frames;
+    const auto                        AT = pattern.find("%d");
+
+    if (pattern.empty() || AT == std::string::npos)
+        return frames;
+
+    for (int i = 0; i < count; ++i) {
+        std::string path = pattern;
+        frames.push_back(loadPng(path.replace(AT, 2, std::to_string(i)), nearest));
+    }
+
+    return frames;
+}
+
+// Loads once per config reload (the button list is rebuilt then). True when
+// every background frame loaded; otherwise the button keeps the upstream look.
+static bool imagesReady(SHyprButton& button) {
+    if (!button.imagesLoaded) {
+        button.imagesLoaded = true;
+        button.bgTex        = loadFrames(button.bgImage);
+        button.fgTex        = loadFrames(button.fgImage);
+        button.fgAltTex     = loadFrames(button.fgImageAlt);
+    }
+
+    return button.bgTex.size() == 8 && std::ranges::all_of(button.bgTex, [](const auto& t) { return t && t->m_texID != 0; });
+}
+
+// 9-slice with the image's SizingMargins (left, right, top, bottom; XP's are
+// 5,5,5,5), as the msstyles draw it.
+static void renderNineSlice(SP<Render::ITexture> tex, const CBox& box, const float scale, const float a, const int* m = nullptr) {
+    static constexpr int XP[4] = {5, 5, 5, 5};
+    if (!m)
+        m = XP;
+    const Vector2D TS = tex->m_size;
+    const double   L = std::min<double>(std::round(m[0] * scale), std::floor(box.w / 2.0));
+    const double   R = std::min<double>(std::round(m[1] * scale), std::floor(box.w / 2.0));
+    const double   T = std::min<double>(std::round(m[2] * scale), std::floor(box.h / 2.0));
+    const double   B = std::min<double>(std::round(m[3] * scale), std::floor(box.h / 2.0));
+
+    const double   sx[4] = {0, m[0] / TS.x, (TS.x - m[1]) / TS.x, 1};
+    const double   sy[4] = {0, m[2] / TS.y, (TS.y - m[3]) / TS.y, 1};
+    const double   dx[4] = {box.x, box.x + L, box.x + box.w - R, box.x + box.w};
+    const double   dy[4] = {box.y, box.y + T, box.y + box.h - B, box.y + box.h};
+
+    for (int r = 0; r < 3; ++r) {
+        for (int c = 0; c < 3; ++c) {
+            const CBox DST = {dx[c], dy[r], dx[c + 1] - dx[c], dy[r + 1] - dy[r]};
+
+            if (DST.w <= 0 || DST.h <= 0)
+                continue;
+
+            g_pHyprOpenGL->renderTexture(tex, DST,
+                                         {.a                           = a,
+                                          .allowCustomUV               = true,
+                                          .primarySurfaceUVTopLeft     = {sx[c], sy[r]},
+                                          .primarySurfaceUVBottomRight = {sx[c + 1], sy[r + 1]}});
+        }
+    }
+}
