+int CHyprBar::buttonAt(Vector2D coords) {
+    const auto HEIGHT           = g_pGlobalState->config.barHeight->value();
+    const auto BARBUTTONPADDING = g_pGlobalState->config.barButtonPadding->value();
+    const auto BARPADDING       = g_pGlobalState->config.barPadding->value();
+    const bool BUTTONSRIGHT     = g_pGlobalState->config.barButtonsAlignment->value() != "left";
+    const auto BARBUF           = Vector2D{(int)assignedBoxGlobal().w, HEIGHT};
+
+    float      offset = BARPADDING;
+    for (size_t i = 0; i < g_pGlobalState->buttons.size(); ++i) {
+        const auto& b          = g_pGlobalState->buttons[i];
+        Vector2D    currentPos = Vector2D{(BUTTONSRIGHT ? BARBUF.x - BARBUTTONPADDING - b.w() - offset : offset), buttonTop(b, BARBUF.y)}.floor();
+
+        if (VECINRECT(coords, currentPos.x, currentPos.y, currentPos.x + b.w() + BARBUTTONPADDING, currentPos.y + b.h()))
+            return i;
+
+        offset += BARBUTTONPADDING + b.w();
+    }
+    return -1;
+}
+
+bool CHyprBar::renderImageButton(SHyprButton& button, size_t i, bool hovering, CBox box, const float scale, const float a) {
+    if (!imagesReady(button))
+        return false;
+
+    const auto PWINDOW = m_pWindow.lock();
+    const int  STATE   = hovering ? (m_iPressedButton == (int)i ? 2 : 1) : 0;
+    const int  FRAME   = STATE + (PWINDOW == Desktop::focusState()->window() ? 0 : 4);
+
+    box.round();
+    renderNineSlice(button.bgTex[FRAME], box, scale, a, button.margins);
+
+    const bool  ALT    = !button.fgAltTex.empty() && Fullscreen::controller()->isFullscreen(PWINDOW);
+    const auto& GLYPHS = ALT ? button.fgAltTex : button.fgTex;
+
+    if (GLYPHS.size() == 8 && GLYPHS[FRAME] && GLYPHS[FRAME]->m_texID != 0) {
+        const auto SIZE  = (GLYPHS[FRAME]->m_size * scale).round();
+        CBox       glyph = {box.x + std::floor((box.w - SIZE.x) / 2.0), box.y + std::floor((box.h - SIZE.y) / 2.0), SIZE.x, SIZE.y};
+        g_pHyprOpenGL->renderTexture(GLYPHS[FRAME], glyph, {.a = a});
+    }
+
+    return true;
+}
