#!/bin/bash
# After a Hyprland update the Vista caption-button hyprbars can only be rebuilt
# once the new Hyprland is running, i.e. at the next login: this is that run.
# Backgrounded and a no-op when the stamp already matches (vista-hyprbars-heal).
setsid -f "$HOME/.config/omarchy/vista/bin/vista-hyprbars-heal" </dev/null >/dev/null 2>&1
exit 0
